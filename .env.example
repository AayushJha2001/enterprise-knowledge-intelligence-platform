# Copy to .env for running the API or tests directly on your machine (outside Docker).
# Inside docker compose these are set in docker-compose.yml.
ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://ekip:ekip@localhost:5433/ekip
REDIS_URL=redis://localhost:6380/0

# Phase 4 (answer generation). Leave empty until then.
ANTHROPIC_API_KEY=
